# 复制本文件为 .env 并填入真实值。
# .env 已在 .gitignore 中，不会被提交。

# ── API 后端（推荐，无需本地 GPU）────────────────────────────
# 获取 DeepSeek key: https://platform.deepseek.com/api_keys
TPC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TPC_API_BASE=https://api.deepseek.com
TPC_API_MODEL=deepseek-chat

# ── 换成其他厂商只需改后两行 ────────────────────────────────
# 智谱 GLM:  TPC_API_BASE=https://open.bigmodel.cn/api/paas/v4   TPC_API_MODEL=glm-4-plus
# 通义千问:  TPC_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1   TPC_API_MODEL=qwen-plus
# OpenAI:    TPC_API_BASE=https://api.openai.com/v1   TPC_API_MODEL=gpt-4o
#
# 注：也兼容 DEEPSEEK_API_KEY / ZHIPUAI_API_KEY / DASHSCOPE_API_KEY / OPENAI_API_KEY。
